{ pkgs, self }:
pkgs.testers.runNixOSTest {
  name = "floppa-service";
  nodes.machine = { pkgs, ... }: {
    imports = [ self.nixosModules.default ];
    services.floppa-vpn = {
      enable = true;
      users = [ "alice" ];
      autostart = false;
    };
    users.users.alice = {
      isNormalUser = true;
      uid = 1000;
    };
    users.users.bob = {
      isNormalUser = true;
      uid = 1001;
    };
    # No interactive desktop in this VM; grant only the packaged helper action.
    security.polkit.extraConfig = ''
      polkit.addRule(function(action, subject) {
        if (action.id == "dev.okhsunrog.floppa-vpn.network-config" && subject.user == "alice")
          return polkit.Result.YES;
      });
    '';
    environment.etc."floppa-test.conf".text = ''
      [Interface]
      PrivateKey = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      Address = 10.77.0.2/24
      [Peer]
      PublicKey = AQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      Endpoint = 127.0.0.1:9
      AllowedIPs = 10.77.0.0/24
    '';
    environment.systemPackages = [
      pkgs.libcap
      pkgs.python3
    ];
  };
  testScript = ''
    start_all()
    machine.wait_for_unit("floppa-vpn.socket")
    machine.succeed("test $(stat -c %a /run/floppa-vpn/vpn.sock) = 660")
    machine.succeed("test $(stat -c %G /run/floppa-vpn/vpn.sock) = floppa")
    machine.succeed("su - alice -c '/run/wrappers/bin/floppa status'")
    machine.wait_for_unit("floppa-vpn.service")
    machine.fail("su - bob -c '/run/wrappers/bin/floppa status'")
    machine.succeed("getcap /run/wrappers/bin/floppa | grep cap_net_admin")
    # A standalone process must never try to install into /usr on NixOS.
    machine.succeed("test -x ${self.packages.x86_64-linux.cli.resources}/lib/floppa-vpn/floppa-network-helper")
    machine.succeed("systemctl stop floppa-vpn.socket floppa-vpn.service")
    machine.succeed("su - alice -c '/run/wrappers/bin/floppa status' 2>&1 | grep -i standalone")
    # Reproduce an upgrade from the old Bash helper: seven duplicate rules and
    # no policy journal. The real client preflight must recover this automatically.
    legacy_policy = "add table inet floppa_policy\\nadd chain inet floppa_policy prerouting { type filter hook prerouting priority mangle; policy accept; }\\nadd rule inet floppa_policy prerouting ct mark 0x666c6f70 meta mark set ct mark\\nadd chain inet floppa_policy postrouting { type filter hook postrouting priority mangle; policy accept; }\\nadd rule inet floppa_policy postrouting meta mark 0x666c6f70 ct mark set meta mark\\n"
    machine.succeed("printf '" + legacy_policy * 7 + "' | ${pkgs.nftables}/bin/nft -f -")
    machine.fail("test -e /var/lib/floppa-vpn/network-rollback-v1/policy")
    # Exercise the real standalone helper and external UDP socket. No provider,
    # enrollment, internet endpoint or production credentials are involved.
    machine.succeed("su - alice -c '/run/wrappers/bin/floppa connect --config /etc/floppa-test.conf --interface floppa0 --no-dns' > /tmp/standalone.log 2>&1 &")
    machine.wait_until_succeeds("ip link show floppa0", timeout=30)
    machine.wait_until_succeeds("ss -uanep | grep 'fwmark:0x666c6f70'", timeout=30)
    machine.succeed("grep -i standalone /tmp/standalone.log")
    machine.succeed("pkill -INT -u alice -f 'floppa.* connect' || true")
    machine.wait_until_fails("ip link show floppa0", timeout=30)

    helper = "${self.packages.x86_64-linux.cli.resources}/lib/floppa-vpn/floppa-network-helper"
    machine.succeed(f"{helper} check-policy")
    # Real resolved per-link state: changing another link's DHCP-style DNS must
    # survive disconnect. Run both the apply and the recovery through the helper.
    machine.succeed(f"{helper} ensure-tun floppa0 0")
    machine.succeed("ip link add upstream0 type dummy; ip link set upstream0 up")
    machine.succeed("resolvectl dns upstream0 192.0.2.53")
    machine.succeed(f"{helper} set-dns-auto floppa0 1.1.1.1")
    machine.succeed("resolvectl dns floppa0 | grep 1.1.1.1")
    machine.succeed("resolvectl domain floppa0 | grep '~\\.'")
    machine.succeed("resolvectl dns upstream0 198.51.100.53")
    machine.succeed(f"{helper} recover-network")
    machine.succeed("resolvectl dns upstream0 | grep 198.51.100.53")
    machine.fail("ip link show floppa0")

    # A running resolved with an ordinary upstream resolv.conf is not the DNS
    # consumer. Exercise the fallback and a concurrent manager's replacement.
    machine.succeed("rm /etc/resolv.conf; printf 'nameserver 192.0.2.53\\n' > /etc/resolv.conf")
    machine.succeed(f"{helper} set-dns-auto floppa0 1.1.1.1")
    machine.succeed("grep 'Generated by floppa-vpn' /etc/resolv.conf")
    machine.succeed("printf '# Generated by NetworkManager\\nnameserver 198.51.100.53\\n' > /etc/resolv.conf")
    machine.succeed(f"{helper} recover-dns")
    machine.succeed("grep 198.51.100.53 /etc/resolv.conf")
    machine.fail("test -e /var/lib/floppa-vpn/network-rollback-v1/dns")
  '';
}
