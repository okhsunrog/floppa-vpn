{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, p.assigned_ip AS \"assigned_ip!\", p.protocol AS \"protocol: Protocol\",\n               cs.speed_limit_mbps\n        FROM peers p\n        LEFT JOIN current_subscriptions cs ON cs.user_id = p.user_id AND cs.is_active\n        WHERE p.user_id = $1 AND p.sync_status = 'active'\n        ",
