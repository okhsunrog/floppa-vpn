<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Permissions the plugin itself needs: the foreground VpnService and its notification, and
      the battery-optimisation request it issues. App-level permissions (INTERNET,
      QUERY_ALL_PACKAGES) live in the app manifest; manifest merging unions the two.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          The second chance for the always-on start, see BootRetry.kt. Both live in `:vpn` with
          the service, so the phase they read is the one the tunnel writes. The receiver is not
          exported: BOOT_COMPLETED is a protected broadcast, and the system's own sends reach an
          unexported receiver. The job service is exported the way every JobService is — the
          scheduler binds it, and the BIND_JOB_SERVICE permission keeps that to the system.
        -->
        <receiver
            android:name="dev.okhsunrog.floppavpn.vpn.BootReceiver"
            android:process=":vpn"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name="dev.okhsunrog.floppavpn.vpn.BootRetryJobService"
            android:process=":vpn"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <service
            android:name="dev.okhsunrog.floppavpn.vpn.FloppaVpnService"
            android:process=":vpn"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:stopWithTask="false"
            android:exported="false">
            <!--
              The system starts the service through this action, with no extras, for always-on
              VPN, at boot and to restore a lockdown session; FloppaVpnService rebuilds the last
              successful tunnel from the autostart bundle on its own. Both system toggles
              ("Always-on VPN", "Block connections without VPN") are therefore available.
            -->
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
          The Quick Settings tile. In `:vpn` with the service, so the phase it shows is a
          process-local read and no `:vpn` process means no tunnel — which is the truth it wants
          to show. Exported because the system, not this app, binds it; the tile permission is
          what keeps that to the system.
        -->
        <service
            android:name="dev.okhsunrog.floppavpn.vpn.FloppaVpnTileService"
            android:process=":vpn"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/vpn_tile_label"
            android:icon="@drawable/ic_qs_tile_vpn"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
