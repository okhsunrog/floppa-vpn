<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Permissions the plugin itself needs: the foreground VpnService and its notification, and
      the battery-optimisation request it issues. App-level permissions (INTERNET,
      QUERY_ALL_PACKAGES) live in the app manifest; manifest merging unions the two.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <service
            android:name="dev.okhsunrog.floppavpn.vpn.FloppaVpnService"
            android:process=":vpn"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:stopWithTask="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!--
              Always-on VPN is unsupported until the :vpn process can persist a config and rebuild
              a tunnel from it on its own: the system starts the service with no configuration, and
              the service can only refuse. With the toggle available, refusing meant "Always-on" did
              nothing and "Block connections without VPN" (lockdown) left the device with no network
              at all. This hides both toggles in the system VPN settings.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>
    </application>
</manifest>
