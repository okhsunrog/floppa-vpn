<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quick Settings tile icon: a shield with a keyhole cut out of it.

  One path rather than two, with `evenOdd` fill: a tile icon is tinted as a single colour by the
  system, so a keyhole drawn as a second shape would be the same colour as the shield and vanish.
  As a hole in the same path it stays a hole whatever the tint is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1.5 L3.5,5.2 V11 C3.5,16.2 7.1,21.1 12,22.3 C16.9,21.1 20.5,16.2 20.5,11 V5.2 L12,1.5 Z M12,8 A1.9,1.9 0 1,0 12,11.8 A1.9,1.9 0 1,0 12,8 Z M11.1,11.4 H12.9 V15.6 H11.1 Z" />
</vector>
