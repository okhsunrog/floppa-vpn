#!/bin/bash
# floppa-network-helper - Privileged network configuration helper for Floppa VPN
#
# This script is run via pkexec. A polkit policy allows it to execute without
# a password prompt for active desktop sessions.
#
# Only validated, specific network operations are permitted.

set -euo pipefail

# Reserved for the single Floppa tunnel owner. Keep in sync with socket_mark::FWMARK.
FWMARK=0x666c6f70
ROUTE_TABLE=1718382448

ALLOWED_IFACE='^floppa[0-9]+$'
# IPv4: digits and dots with optional /prefix
# IPv6: hex digits, colons with optional /prefix
IP_PATTERN='^[0-9a-fA-F.:]+(/[0-9]+)?$'

validate_iface() {
    if [[ ! "$1" =~ $ALLOWED_IFACE ]]; then
        echo "Invalid interface name: $1" >&2
        exit 1
    fi
}

validate_ip() {
    if [[ ! "$1" =~ $IP_PATTERN ]]; then
        echo "Invalid IP/network: $1" >&2
        exit 1
    fi
}

validate_uid() {
    if [[ ! "$1" =~ ^[0-9]+$ ]]; then
        echo "Invalid UID: $1" >&2
        exit 1
    fi
}

# The helper captures undo data itself. No caller supplies a journal path, shell command,
# original DNS contents or original sysctl value. All owners share this root-only store.
STATE=/var/lib/floppa-vpn/network-rollback-v1
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
validate_boot() {
    [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
        echo 'Invalid recovery boot identifier' >&2; exit 1;
    }
}
state_open() {
    local dir mode
    for dir in /var/lib/floppa-vpn "$STATE"; do
        [[ ! -L "$dir" ]] || { echo "Unsafe recovery directory: $dir" >&2; exit 1; }
        [[ -d "$dir" ]] || install -d -o 0 -g 0 -m 0700 "$dir"
        mode=$(stat -c %a "$dir")
        [[ $(stat -c %u "$dir") == 0 ]] && (( (8#$mode & 8#022) == 0 )) || exit 1
    done
    chmod 0700 "$STATE"
    sync /var/lib /var/lib/floppa-vpn "$STATE"
    # Serialize helper invocations, including a helper still finishing after its parent died.
    [[ ! -L "$STATE/lock" ]] || exit 1
    exec 9>"$STATE/lock"
    chmod 0600 "$STATE/lock"
    flock -x 9
}
state_save() {
    local name=$1 tmp
    shift
    [[ ! -e "$STATE/$name" && ! -L "$STATE/$name" ]] || {
        echo "Pending $name recovery; restore the previous tunnel first" >&2; exit 1;
    }
    tmp=$(mktemp "$STATE/.pending.XXXXXX")
    printf '%s\0' "$@" > "$tmp"
    sync "$tmp"
    mv -T "$tmp" "$STATE/$name"
    sync "$STATE"
}
state_load() {
    local name=$1 mode
    RECORD=()
    [[ -e "$STATE/$name" || -L "$STATE/$name" ]] || return 1
    mode=$(stat -c %a "$STATE/$name")
    if [[ ! -f "$STATE/$name" || -L "$STATE/$name" || $(stat -c %u "$STATE/$name") != 0 ||
          $(stat -c %h "$STATE/$name") != 1 || $(stat -c %s "$STATE/$name") -gt 1048576 ]] ||
          (( (8#$mode & 8#077) != 0 )); then
        echo "Unsafe recovery record: $name" >&2; exit 1
    fi
    mapfile -d '' -t RECORD < "$STATE/$name"
    [[ ${#RECORD[@]} -gt 0 ]] || { echo "Empty recovery record: $name" >&2; exit 1; }
}
state_clear() {
    rm -f "$STATE/$1"
    sync "$STATE"
}
recover_routes() {
    state_load routes || return 0
    [[ ${#RECORD[@]} -eq 2 ]] || exit 1
    validate_iface "${RECORD[0]}"
    validate_boot "${RECORD[1]}"
    if [[ "${RECORD[1]}" != "$BOOT_ID" ]]; then state_clear routes; return 0; fi
    # This table is reserved and checked empty before recording the first route.
    local family routes
    for family in 4 6; do
        routes=$(ip -N -"$family" route show table all)
        if grep -Eq " table $ROUTE_TABLE( |$)" <<< "$routes"; then
            ip -"$family" route flush table "$ROUTE_TABLE"
        fi
    done
    state_clear routes
}
recover_policy() {
    state_load policy || return 0
    [[ ${#RECORD[@]} -eq 4 && "${RECORD[0]}" =~ ^[01]$ && "${RECORD[1]}" =~ ^[01]$ &&
       "${RECORD[2]}" =~ ^(-|0|1)$ ]] || exit 1
    validate_boot "${RECORD[3]}"
    if [[ "${RECORD[3]}" != "$BOOT_ID" ]]; then state_clear policy; return 0; fi
    local family rules
    for family in 4 6; do
        [[ "$family" != 4 || "${RECORD[0]}" == 1 ]] || continue
        [[ "$family" != 6 || "${RECORD[1]}" == 1 ]] || continue
        ip -"$family" rule del priority 31010 not fwmark "$FWMARK" lookup "$ROUTE_TABLE" 2>/dev/null || true
        ip -"$family" rule del priority 31000 not fwmark "$FWMARK" lookup main suppress_prefixlength 0 2>/dev/null || true
        rules=$(ip -"$family" rule show)
        if grep -Eq '^310(00|10):' <<< "$rules"; then
            echo 'Could not remove reserved routing rules' >&2; return 1
        fi
    done
    local tables
    tables=$(nft list tables)
    if grep -qx 'table inet floppa_policy' <<< "$tables"; then nft delete table inet floppa_policy; fi
    [[ "${RECORD[2]}" == - ]] || sysctl -q -w "net.ipv4.conf.all.src_valid_mark=${RECORD[2]}"
    state_clear policy
}
capture_resolver() {
    local identity digest
    identity=$(stat -c '%d:%i' "$1")
    digest=$(sha256sum "$1"); digest=${digest%% *}
    [[ ! -e "$STATE/dns" && ! -L "$STATE/dns" ]] || { echo 'Pending DNS recovery' >&2; exit 1; }
    if [[ -L /etc/resolv.conf ]]; then
        state_save dns link-v2 "$(readlink /etc/resolv.conf)" "$identity" "$digest"
    elif [[ -e /etc/resolv.conf ]]; then
        [[ -f /etc/resolv.conf ]] || exit 1
        local tmp
        tmp=$(mktemp "$STATE/.resolver.XXXXXX")
        cat /etc/resolv.conf > "$tmp"
        sync "$tmp"
        mv -T "$tmp" "$STATE/resolver-backup"
        sync "$STATE"
        state_save dns file-v2 "$identity" "$digest"
    else
        state_save dns absent-v2 "$identity" "$digest"
    fi
}
recover_dns() {
    state_load dns || return 0
    local iface
    if [[ "${RECORD[0]}" != resolved ]]; then
        # A failed filesystem operation is retryable; an external DNS update is not ours
        # to undo. Check both the installed inode and bytes (also catches in-place writes).
        [[ ! -d /etc/resolv.conf ]] || { echo 'Resolver is a directory' >&2; return 1; }
        local owned=0 identity digest count=${#RECORD[@]}
        case "${RECORD[0]}" in
            file-v2|absent-v2) [[ $count -eq 3 ]] || exit 1 ;;
            link-v2) [[ $count -eq 4 && -n "${RECORD[1]}" ]] || exit 1 ;;
            file|absent) [[ $count -eq 1 ]] || exit 1 ;;
            link) [[ $count -eq 2 && -n "${RECORD[1]}" ]] || exit 1 ;;
            *) echo 'Invalid DNS recovery record' >&2; exit 1 ;;
        esac
        if [[ "${RECORD[0]}" == *-v2 ]]; then
            identity=${RECORD[count-2]}; digest=${RECORD[count-1]}
            [[ "$identity" =~ ^[0-9]+:[0-9]+$ && "$digest" =~ ^[0-9a-f]{64}$ ]] || exit 1
        fi
        if [[ -f /etc/resolv.conf && ! -L /etc/resolv.conf ]]; then
            if [[ "${RECORD[0]}" == *-v2 ]]; then
                if [[ $(stat -c '%d:%i' /etc/resolv.conf) == "$identity" &&
                      $(sha256sum /etc/resolv.conf) == "$digest "* ]]; then owned=1; fi
            else
                # Compatibility with journals written before ownership fingerprints existed.
                local header
                IFS= read -r header < /etc/resolv.conf || true
                [[ "$header" != '# Generated by floppa-vpn' ]] || owned=1
            fi
        fi
        if [[ $owned == 0 ]]; then
            echo 'Resolver changed externally; preserving current DNS configuration' >&2
            state_clear dns
            rm -f "$STATE/resolver-backup"
            return 0
        fi
        if [[ "${RECORD[0]}" == *-v2 ]]; then
            RECORD=("${RECORD[@]:0:count-2}")
            RECORD[0]=${RECORD[0]%-v2}
        fi
    fi
    case "${RECORD[0]}" in
        resolved)
            [[ ${#RECORD[@]} -eq 3 ]] || exit 1
            iface=${RECORD[1]}; validate_iface "$iface"
            validate_boot "${RECORD[2]}"
            if [[ "${RECORD[2]}" != "$BOOT_ID" ]]; then state_clear dns; return 0; fi
            # A vanished link has no per-link resolver state left to revert.
            if [[ -d "/sys/class/net/$iface" ]]; then resolvectl revert "$iface"; fi
            ;;
        link)
            [[ ${#RECORD[@]} -eq 2 && -n "${RECORD[1]}" ]] || exit 1
            ln -sfnT -- "${RECORD[1]}" /etc/resolv.conf
            sync /etc
            ;;
        file)
            [[ ${#RECORD[@]} -eq 1 ]] || exit 1
            [[ -f "$STATE/resolver-backup" && ! -L "$STATE/resolver-backup" ]] || exit 1
            rm -f /etc/resolv.conf
            install -m 0644 "$STATE/resolver-backup" /etc/resolv.conf
            sync /etc/resolv.conf /etc
            ;;
        absent)
            [[ ${#RECORD[@]} -eq 1 ]] || exit 1
            rm -f /etc/resolv.conf
            sync /etc
            ;;
        *) echo 'Invalid DNS recovery record' >&2; exit 1 ;;
    esac
    state_clear dns
    rm -f "$STATE/resolver-backup"
}

# A running resolved can merely consume NetworkManager's resolv.conf. Only use its
# per-link API when resolv.conf actually sends queries to resolved's local stub.
resolved_owns_dns() {
    [[ -f /etc/resolv.conf ]] || return 1
    local line keyword server rest seen=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        read -r keyword server rest <<< "$line"
        [[ "$keyword" == nameserver ]] || continue
        seen=1
        [[ "$server" == 127.0.0.53 || "$server" == 127.0.0.54 ]] || return 1
    done < /etc/resolv.conf
    [[ $seen == 1 ]] || return 1
    resolvectl status >/dev/null 2>&1
}
recover_link() {
    state_load link || return 0
    [[ ${#RECORD[@]} -eq 2 ]] || exit 1
    local iface=${RECORD[0]}
    validate_boot "${RECORD[1]}"
    if [[ "${RECORD[1]}" != "$BOOT_ID" ]]; then state_clear link; return 0; fi
    validate_iface "$iface"
    if [[ -d "/sys/class/net/$iface" ]]; then
        ip link set "$iface" down
        ip addr flush dev "$iface"
        ip tuntap del dev "$iface" mode tun
    fi
    state_clear link
}

if [[ "${1:-}" == set-dns-auto ]]; then
    [[ $# -ge 3 ]] || exit 1
    validate_iface "$2"
    if resolved_owns_dns; then
        set -- set-dns "${@:2}"
    else
        set -- set-dns-file "${@:3}"
    fi
fi

case "${1:-}" in
    recover-network|recover-dns|recover-policy|recover-routes|recover-link)
        [[ $# -eq 1 ]] || exit 1
        state_open
        case "$1" in
            recover-network) recover_dns; recover_policy; recover_routes; recover_link ;;
            recover-dns) recover_dns ;;
            recover-policy) recover_policy ;;
            recover-routes) recover_routes ;;
            recover-link) recover_link ;;
        esac
        exit 0
        ;;
esac

case "${1:-}" in
    check-policy)
        [[ $# -eq 1 ]] || exit 1
        # Called after journal recovery and before recording any new mutations. Refuse a
        # collision rather than later deleting rules/table that belong to another owner.
        tables=$(nft list tables)
        if grep -qx 'table inet floppa_policy' <<< "$tables"; then
            echo 'Reserved nftables table floppa_policy is already in use; recover the previous tunnel first' >&2
            exit 1
        fi
        for family in 4 6; do
            rules=$(ip -"$family" rule show)
            routes=$(ip -N -"$family" route show table all)
            if grep -Eq '^310(00|10):' <<< "$rules" ||
                grep -Eq " table $ROUTE_TABLE( |$)" <<< "$routes"; then
                echo "Reserved Floppa IPv$family routing rules/table are already in use" >&2
                exit 1
            fi
        done
        ;;
    prepare-ownership)
        [[ $# -eq 1 ]] || exit 1
        # /run is root-owned. Never replace an existing lock inode, including during upgrades.
        [[ ! -L /run/floppa-vpn ]] || exit 1
        [[ -d /run/floppa-vpn ]] || install -d -o root -g root -m 0755 /run/floppa-vpn
        [[ $(stat -c %u /run/floppa-vpn) == 0 ]] || exit 1
        owner_dir_mode=$(stat -c %a /run/floppa-vpn)
        (( (8#$owner_dir_mode & 8#022) == 0 )) || exit 1
        [[ ! -L /run/floppa-vpn/tunnel.lock ]] || exit 1
        ( set -o noclobber; : > /run/floppa-vpn/tunnel.lock ) 2>/dev/null || true
        [[ -f /run/floppa-vpn/tunnel.lock ]] || exit 1
        [[ $(stat -c %h /run/floppa-vpn/tunnel.lock) == 1 ]] || exit 1
        chown root:root /run/floppa-vpn/tunnel.lock
        chmod 0444 /run/floppa-vpn/tunnel.lock
        ;;
    ensure-tun)
        # Usage: ensure-tun <iface> <uid>
        #
        # The persistent TUN outlives a run — `deconfigure` only downs it and flushes its
        # addresses — so finding one already there is the ordinary case, and re-creating it is not
        # what is wanted. But "already there" is not the same as "ours": once a machine can run the
        # tunnel from more than one place (the system service, an unprivileged app, `sudo floppa`),
        # a second one that simply accepted the existing device would lay its own routes and DNS
        # over the first one's, holding a rollback journal that knows nothing about them. It is
        # also the only chance to notice: this helper runs privileged in every one of those modes,
        # so it is the one place that can arbitrate between them.
        #
        # `/sys/class/net/<iface>/owner` is the uid a tuntap device was created for, and -1 when it
        # was created for nobody. Anything that is not the uid asking is somebody else's.
        [[ $# -eq 3 ]] || { echo "Usage: ensure-tun <iface> <uid>" >&2; exit 1; }
        validate_iface "$2"
        validate_uid "$3"
        if ip link show dev "$2" >/dev/null 2>&1; then
            owner=$(cat "/sys/class/net/$2/owner" 2>/dev/null || true)
            if [[ -z "$owner" ]]; then
                echo "$2 already exists and is not a tuntap device" >&2
                exit 1
            elif [[ "$owner" == "-1" ]]; then
                echo "$2 already exists and belongs to no user; remove it with 'ip tuntap del dev $2 mode tun'" >&2
                exit 1
            elif [[ "$owner" != "$3" ]]; then
                echo "$2 is already in use by uid $owner; another Floppa VPN client is running" >&2
                exit 1
            fi
        fi
        state_open
        state_save link "$2" "$BOOT_ID"
        if ! ip link show dev "$2" >/dev/null 2>&1; then
            ip tuntap add dev "$2" mode tun user "$3"
        fi
        ;;

    set-mtu)
        [[ $# -eq 3 ]] || { echo "Usage: set-mtu <iface> <mtu>" >&2; exit 1; }
        validate_iface "$2"
        [[ "$3" =~ ^[0-9]{4}$ && "$3" -ge 1280 && "$3" -le 9000 ]] || { echo "Invalid MTU" >&2; exit 1; }
        ip link set dev "$2" mtu "$3"
        ;;

    configure)
        # Usage: configure <iface> <ip/prefix>
        # `addr replace` rather than `addr add`: applying the same address twice must succeed,
        # otherwise a retry or a second protocol probe fails before the link is brought up.
        [[ $# -eq 3 ]] || { echo "Usage: configure <iface> <ip/prefix>" >&2; exit 1; }
        validate_iface "$2"
        validate_ip "$3"
        ip addr replace "$3" dev "$2"
        ip link set "$2" up
        ;;

    flush-addr)
        # Usage: flush-addr <iface> <ip/prefix>
        # Undo for `configure`, removing exactly the address that was applied.
        [[ $# -eq 3 ]] || { echo "Usage: flush-addr <iface> <ip/prefix>" >&2; exit 1; }
        validate_iface "$2"
        validate_ip "$3"
        ip addr del "$3" dev "$2" 2>/dev/null || true
        ;;

    add-routes)
        # Usage: add-routes <iface> <dest1> [dest2 ...]
        [[ $# -ge 3 ]] || { echo "Usage: add-routes <iface> <dest1> [dest2 ...]" >&2; exit 1; }
        validate_iface "$2"
        iface="$2"
        shift 2
        for dest in "$@"; do validate_ip "$dest"; done
        state_open
        for family in 4 6; do
            routes=$(ip -N -"$family" route show table all)
            if grep -Eq " table $ROUTE_TABLE( |$)" <<< "$routes"; then
                echo 'Reserved routing table already in use' >&2; exit 1
            fi
        done
        state_save routes "$iface" "$BOOT_ID"
        for dest in "$@"; do
            validate_ip "$dest"
            family=4; [[ "$dest" != *:* ]] || family=6
            ip -"$family" route add "$dest" dev "$iface" table "$ROUTE_TABLE"
        done
        ;;

    add-policy)
        [[ $# -eq 3 && "$2" =~ ^[01]$ && "$3" =~ ^[01]$ ]] || exit 1
        state_open
        tables=$(nft list tables)
        if grep -qx 'table inet floppa_policy' <<< "$tables"; then
            echo 'Reserved nftables table already in use' >&2; exit 1
        fi
        for family in 4 6; do
            rules=$(ip -"$family" rule show)
            if grep -Eq '^310(00|10):' <<< "$rules"; then
                echo 'Reserved rule priorities already in use' >&2; exit 1
            fi
        done
        old_mark=-
        [[ "$2" == 0 ]] || old_mark=$(cat /proc/sys/net/ipv4/conf/all/src_valid_mark)
        state_save policy "$2" "$3" "$old_mark" "$BOOT_ID"
        # Conntrack restores the outbound socket mark on replies, so strict reverse-path
        # validation looks up the physical route rather than the VPN table.
        nft -f - <<'NFT'
add table inet floppa_policy
add chain inet floppa_policy prerouting { type filter hook prerouting priority mangle; policy accept; }
add rule inet floppa_policy prerouting ct mark 0x666c6f70 meta mark set ct mark
add chain inet floppa_policy postrouting { type filter hook postrouting priority mangle; policy accept; }
add rule inet floppa_policy postrouting meta mark 0x666c6f70 ct mark set meta mark
NFT
        [[ "$2" == 0 ]] || sysctl -q -w net.ipv4.conf.all.src_valid_mark=1
        for family in 4 6; do
            [[ "$family" != 4 || "$2" == 1 ]] || continue
            [[ "$family" != 6 || "$3" == 1 ]] || continue
            # More-specific system routes (LAN, corporate VPN) retain precedence.
            ip -"$family" rule add priority 31000 not fwmark "$FWMARK" lookup main suppress_prefixlength 0
            ip -"$family" rule add priority 31010 not fwmark "$FWMARK" lookup "$ROUTE_TABLE"
        done
        ;;

    set-dns)
        # Usage: set-dns <iface> <server1> [server2 ...]
        [[ $# -ge 3 ]] || { echo "Usage: set-dns <iface> <server1> [server2 ...]" >&2; exit 1; }
        validate_iface "$2"
        iface="$2"
        shift 2
        for s in "$@"; do validate_ip "$s"; done
        state_open
        state_save dns resolved "$iface" "$BOOT_ID"
        resolvectl dns "$iface" "$@"
        # '~.' makes this link the routing domain for every name. Without it the physical link
        # keeps default-route too, and resolved sends queries that match no routing domain to
        # ALL default-route links in parallel — so a share of lookups still went to the
        # provider's resolver. This is what wg-quick's `resolvconf -x` does. `revert` clears it.
        resolvectl domain "$iface" '~.'
        resolvectl default-route "$iface" true
        ;;

    set-dns-file)
        [[ $# -ge 2 ]] || exit 1
        shift
        for server in "$@"; do validate_ip "$server"; done
        state_open
        # Generate the new file here; never read a caller-selected file as root.
        tmp=$(mktemp /etc/.floppa-resolv.XXXXXX)
        trap 'rm -f -- "$tmp"' EXIT
        { printf '# Generated by floppa-vpn\n'; printf 'nameserver %s\n' "$@"; } > "$tmp"
        chmod 0644 "$tmp"
        sync "$tmp"
        capture_resolver "$tmp"
        mv -T "$tmp" /etc/resolv.conf
        sync /etc
        ;;

    *)
        echo "Unknown command: ${1:-}" >&2
        echo "Commands: check-policy, prepare-ownership, ensure-tun, configure, flush-addr, add-routes, add-policy, set-dns-auto, set-dns, set-dns-file, recover-network, recover-dns, recover-policy, recover-routes, recover-link" >&2
        exit 1
        ;;
esac
