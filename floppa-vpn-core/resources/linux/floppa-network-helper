#!/bin/bash
# floppa-network-helper - Privileged network configuration helper for Floppa VPN
#
# This script is run via pkexec. A polkit policy allows it to execute without
# a password prompt for active desktop sessions.
#
# Only validated, specific network operations are permitted.

set -euo pipefail

ALLOWED_IFACE='^floppa[0-9]+$'
# IPv4: digits and dots with optional /prefix
# IPv6: hex digits, colons with optional /prefix
IP_PATTERN='^[0-9a-fA-F.:]+(/[0-9]+)?$'

validate_iface() {
    if [[ ! "$1" =~ $ALLOWED_IFACE ]]; then
        echo "Invalid interface name: $1" >&2
        exit 1
    fi
}

validate_ip() {
    if [[ ! "$1" =~ $IP_PATTERN ]]; then
        echo "Invalid IP/network: $1" >&2
        exit 1
    fi
}

validate_uid() {
    if [[ ! "$1" =~ ^[0-9]+$ ]]; then
        echo "Invalid UID: $1" >&2
        exit 1
    fi
}

# Symlink targets we are willing to recreate for /etc/resolv.conf: absolute, no traversal,
# and confined to the directories resolver stubs actually live in.
validate_link_target() {
    if [[ "$1" == *".."* ]] || [[ ! "$1" =~ ^/(run|var/run|etc)/[A-Za-z0-9._/-]+$ ]]; then
        echo "Invalid resolv.conf link target: $1" >&2
        exit 1
    fi
}

# Undo may legitimately find an object already removed with its interface. Other failures
# must reach the durable journal so cleanup is retried rather than silently forgotten.
remove_policy_object() {
    local output
    if output=$(LC_ALL=C "$@" 2>&1); then return 0; fi
    case "$output" in
        *"No such file or directory"*|*"No such process"*|*"FIB table does not exist"*|*"Cannot find device"*) return 0 ;;
        *) echo "$output" >&2; return 1 ;;
    esac
}

case "${1:-}" in
    check-policy)
        [[ $# -eq 3 && "$2" =~ ^[0-9]+$ && "$3" =~ ^[0-9]+$ && "$3" -ge 89 && "$3" -le 153 ]] || exit 1
        table="$2"
        [[ "$table" == 254 || ( "$table" -ge 52600 && "$table" -le 52663 ) ]] || exit 1
        if ip -4 rule show | grep -qE "^${3}:"; then
            echo "Policy priority $3 is already occupied" >&2; exit 1
        fi
        if [[ "$table" != 254 ]] && [[ -n "$(ip -4 route show table "$table" 2>/dev/null || true)" ]]; then
            echo "Routing table $table is already occupied" >&2; exit 1
        fi
        ;;
    add-policy|del-policy)
        [[ $# -eq 6 ]] || exit 1
        operation="$1"; dest="$2"; table="$3"; priority="$4"; dev="$5"; gateway="$6"
        validate_ip "$dest"
        [[ "$table" =~ ^[0-9]+$ && "$priority" =~ ^[0-9]+$ && "$priority" -ge 89 && "$priority" -le 153 ]] || exit 1
        [[ "$table" == 254 || ( "$table" -ge 52600 && "$table" -le 52663 ) ]] || exit 1
        route_args=()
        if [[ "$table" != 254 ]]; then
            [[ "$dev" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || exit 1
            if [[ "$gateway" != - ]]; then validate_ip "$gateway"; route_args+=(via "$gateway"); fi
            route_args+=(dev "$dev" proto 186)
        fi
        if [[ "$operation" == add-policy ]]; then
            if [[ "$table" != 254 ]]; then
                ip -4 route add table "$table" default "${route_args[@]}"
                # Keep a vanished uplink from falling through into another VPN.
                ip -4 route add table "$table" unreachable default metric 42760 proto 186
            fi
            ip -4 rule add priority "$priority" to "$dest" table "$table" protocol 186
        else
            # Only exact owned objects; never flush a table or delete another client's rule.
            remove_policy_object ip -4 rule del priority "$priority" to "$dest" table "$table" protocol 186
            if [[ "$table" != 254 ]]; then
                remove_policy_object ip -4 route del table "$table" default "${route_args[@]}"
                remove_policy_object ip -4 route del table "$table" unreachable default metric 42760 proto 186
            fi
        fi
        ;;
    ensure-tun)
        # Usage: ensure-tun <iface> <uid>
        #
        # The persistent TUN outlives a run — `deconfigure` only downs it and flushes its
        # addresses — so finding one already there is the ordinary case, and re-creating it is not
        # what is wanted. But "already there" is not the same as "ours": once a machine can run the
        # tunnel from more than one place (the system service, an unprivileged app, `sudo floppa`),
        # a second one that simply accepted the existing device would lay its own routes and DNS
        # over the first one's, holding a rollback journal that knows nothing about them. It is
        # also the only chance to notice: this helper runs privileged in every one of those modes,
        # so it is the one place that can arbitrate between them.
        #
        # `/sys/class/net/<iface>/owner` is the uid a tuntap device was created for, and -1 when it
        # was created for nobody. Anything that is not the uid asking is somebody else's.
        [[ $# -eq 3 ]] || { echo "Usage: ensure-tun <iface> <uid>" >&2; exit 1; }
        validate_iface "$2"
        validate_uid "$3"
        if ip link show dev "$2" >/dev/null 2>&1; then
            owner=$(cat "/sys/class/net/$2/owner" 2>/dev/null || true)
            if [[ -z "$owner" ]]; then
                echo "$2 already exists and is not a tuntap device" >&2
                exit 1
            elif [[ "$owner" == "-1" ]]; then
                echo "$2 already exists and belongs to no user; remove it with 'ip tuntap del dev $2 mode tun'" >&2
                exit 1
            elif [[ "$owner" != "$3" ]]; then
                echo "$2 is already in use by uid $owner; another Floppa VPN client is running" >&2
                exit 1
            fi
        else
            ip tuntap add dev "$2" mode tun user "$3"
        fi
        ;;

    configure)
        # Usage: configure <iface> <ip/prefix>
        # `addr replace` rather than `addr add`: applying the same address twice must succeed,
        # otherwise a retry or a second protocol probe fails before the link is brought up.
        [[ $# -eq 3 ]] || { echo "Usage: configure <iface> <ip/prefix>" >&2; exit 1; }
        validate_iface "$2"
        validate_ip "$3"
        ip addr replace "$3" dev "$2"
        ip link set "$2" up
        ;;

    flush-addr)
        # Usage: flush-addr <iface> <ip/prefix>
        # Undo for `configure`, removing exactly the address that was applied.
        [[ $# -eq 3 ]] || { echo "Usage: flush-addr <iface> <ip/prefix>" >&2; exit 1; }
        validate_iface "$2"
        validate_ip "$3"
        ip addr del "$3" dev "$2" 2>/dev/null || true
        ;;

    deconfigure)
        # Usage: deconfigure <iface>
        [[ $# -eq 2 ]] || { echo "Usage: deconfigure <iface>" >&2; exit 1; }
        validate_iface "$2"
        ip link set "$2" down 2>/dev/null || true
        ip addr flush dev "$2" 2>/dev/null || true
        ;;

    add-route)
        # Usage: add-route <destination> via <gateway>
        [[ $# -eq 4 && "$3" == "via" ]] || { echo "Usage: add-route <dest> via <gateway>" >&2; exit 1; }
        validate_ip "$2"
        validate_ip "$4"
        ip route add "$2" via "$4"
        ;;

    del-route)
        # Usage: del-route <destination> [via <gateway>]
        # The gateway is optional but should always be passed when the route was added with one:
        # without it this deletes ANY route to that destination, which after a roaming event —
        # exactly when a reconnect happens — is the wrong route or none at all.
        case $# in
            2)
                validate_ip "$2"
                ip route del "$2" 2>/dev/null || true
                ;;
            4)
                [[ "$3" == "via" ]] || { echo "Usage: del-route <dest> [via <gw>]" >&2; exit 1; }
                validate_ip "$2"
                validate_ip "$4"
                ip route del "$2" via "$4" 2>/dev/null || true
                ;;
            *)
                echo "Usage: del-route <dest> [via <gw>]" >&2; exit 1
                ;;
        esac
        ;;

    add-routes)
        # Usage: add-routes <iface> <dest1> [dest2 ...]
        [[ $# -ge 3 ]] || { echo "Usage: add-routes <iface> <dest1> [dest2 ...]" >&2; exit 1; }
        validate_iface "$2"
        iface="$2"
        shift 2
        for dest in "$@"; do
            validate_ip "$dest"
            ip route add "$dest" dev "$iface"
        done
        ;;

    del-routes)
        # Usage: del-routes <iface> <dest1> [dest2 ...]
        [[ $# -ge 3 ]] || { echo "Usage: del-routes <iface> <dest1> [dest2 ...]" >&2; exit 1; }
        validate_iface "$2"
        iface="$2"
        shift 2
        for dest in "$@"; do
            validate_ip "$dest"
            ip route del "$dest" dev "$iface" 2>/dev/null || true
        done
        ;;

    set-dns)
        # Usage: set-dns <iface> <server1> [server2 ...]
        [[ $# -ge 3 ]] || { echo "Usage: set-dns <iface> <server1> [server2 ...]" >&2; exit 1; }
        validate_iface "$2"
        iface="$2"
        shift 2
        for s in "$@"; do validate_ip "$s"; done
        resolvectl dns "$iface" "$@"
        # '~.' makes this link the routing domain for every name. Without it the physical link
        # keeps default-route too, and resolved sends queries that match no routing domain to
        # ALL default-route links in parallel — so a share of lookups still went to the
        # provider's resolver. This is what wg-quick's `resolvconf -x` does. `revert` clears it.
        resolvectl domain "$iface" '~.'
        resolvectl default-route "$iface" true
        ;;

    revert-dns)
        # Usage: revert-dns <iface>
        [[ $# -eq 2 ]] || { echo "Usage: revert-dns <iface>" >&2; exit 1; }
        validate_iface "$2"
        resolvectl revert "$2" 2>/dev/null || true
        ;;

    set-resolv-conf)
        # Usage: set-resolv-conf <temp-file>
        # Only accepts files from /tmp/floppa-resolv*
        #
        # `cp` onto /etc/resolv.conf FOLLOWS a symlink and writes through it. On a
        # systemd-resolved host that link points at /run/systemd/resolve/stub-resolv.conf, so a
        # plain cp silently overwrites systemd's own file and the damage outlives the VPN.
        # Replace the link itself instead; `restore-resolv-conf-link` puts it back.
        [[ $# -eq 2 ]] || { echo "Usage: set-resolv-conf <file>" >&2; exit 1; }
        [[ "$2" == /tmp/floppa-resolv* ]] || { echo "Invalid source path: $2" >&2; exit 1; }
        [[ -f "$2" ]] || { echo "File not found: $2" >&2; exit 1; }
        rm -f /etc/resolv.conf
        install -m 644 "$2" /etc/resolv.conf
        ;;

    restore-resolv-conf-link)
        # Usage: restore-resolv-conf-link <target>
        # Undo for the case where /etc/resolv.conf WAS a symlink before we touched it.
        [[ $# -eq 2 ]] || { echo "Usage: restore-resolv-conf-link <target>" >&2; exit 1; }
        validate_link_target "$2"
        ln -sfn "$2" /etc/resolv.conf
        ;;

    *)
        echo "Unknown command: ${1:-}" >&2
        echo "Commands: ensure-tun, configure, flush-addr, deconfigure, add-route, del-route, add-routes, del-routes, set-dns, revert-dns, set-resolv-conf, restore-resolv-conf-link" >&2
        exit 1
        ;;
esac
